# ==============================================================================
# VRCPulse Web Server - Production Dockerfile
# ==============================================================================

# Stage 1: Build frontend
FROM node:22-slim AS frontend

WORKDIR /app/desktop
COPY desktop/package.json desktop/package-lock.json ./
RUN npm ci
COPY desktop/ ./
RUN npm run build

# Stage 2: Build Rust server
FROM rust:1.91-slim-bookworm AS builder

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    pkg-config \
    libssl-dev \
    libsqlite3-dev \
    && rm -rf /var/lib/apt/lists/*

# Copy entire project
COPY Cargo.toml Cargo.lock ./
COPY crates/ ./crates/
COPY migration/ ./migration/
COPY desktop/src-tauri/Cargo.toml desktop/src-tauri/
COPY desktop/src-tauri/src/ desktop/src-tauri/src/
COPY desktop/src-tauri/build.rs desktop/src-tauri/

# Build only the server binary
RUN cargo build --release -p vrcpulse-server

# Stage 3: Runtime
FROM debian:bookworm-slim

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    libsqlite3-0 \
    && rm -rf /var/lib/apt/lists/*

COPY --from=builder /app/target/release/vrcpulse-server ./vrcpulse-server
COPY --from=frontend /app/desktop/build ./static

RUN mkdir -p /data

ENV DATABASE_URL=sqlite:///data/vrcpulse.db?mode=rwc
ENV PORT=80
ENV RUST_LOG=info,vrcpulse=info

VOLUME ["/data"]
EXPOSE 80

CMD ["./vrcpulse-server"]
